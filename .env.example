# Copier ce fichier en `.env` (ignoré par Git) et remplacer les valeurs.
# Aucune valeur réelle ici : ce fichier est public.

# Clé secrète de Django, propre à chaque environnement. Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-valeur-aleatoire-propre-a-votre-poste

# `true` en développement local uniquement.
DJANGO_DEBUG=true

# Noms d'hôtes autorisés, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# `true` uniquement derrière HTTPS (Vercel) : cookies sécurisés, redirection, HSTS.
DJANGO_HTTPS=false

# Base locale (compose.yaml). Mots de passe fictifs à remplacer, propres à votre poste.
POSTGRES_PASSWORD=remplacer-superutilisateur-local
DB_NAME=suivi
DB_HOST=127.0.0.1
DB_PORT=5432
# `require` sur Neon ; `prefer` suffit en local.
DB_SSLMODE=prefer
# Rôle de migration : migrations, tests, commandes de gestion en local.
DB_USER=suivi_migration
DB_PASSWORD=remplacer-role-de-migration
# Rôle d'exécution : celui de l'application déployée ; vérifié par les tests d'intégration.
DB_RUNTIME_USER=suivi_execution
DB_RUNTIME_PASSWORD=remplacer-role-d-execution
