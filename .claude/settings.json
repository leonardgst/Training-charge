{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run playwright install *)",
      "Bash(uv run --env-file .env pytest *)",
      "Bash(uv run --env-file .env python manage.py migrate *)",
      "Bash(uv run --env-file .env python manage.py makemigrations *)",
      "Bash(uv run --env-file .env python manage.py check *)",
      "Bash(uv run --env-file .env python manage.py generer_demo *)",
      "Bash(uv run --env-file .env python manage.py runserver *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(docker compose down *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(gh api *)",
      "Bash(gh workflow *)",
      "Edit(/suivi/migrations/**)",
      "Edit(/suivi/models.py)",
      "Edit(/suivi/acces.py)",
      "Edit(/suivi/views/joueur.py)",
      "Edit(/engine/**)",
      "Edit(/config/calcul.toml)",
      "Edit(/config/settings.py)",
      "Edit(/compose.yaml)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Edit(/.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head * .env)",
      "Bash(tail * .env)",
      "Bash(grep * .env)",
      "Bash(sed * .env)",
      "Bash(awk * .env)",
      "Bash(less .env)",
      "Bash(source *)",
      "Bash(. ./.env*)",
      "Bash(. .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Edit(/tests/reference/**/attendu.csv)",
      "Edit(/tests/reference/**/provenance.md)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--force*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(neonctl *)"
    ]
  }
}
